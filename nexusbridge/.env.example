# Default gateway backend endpoint (optional).
# Accepts a full URL or a bare backend-owned domain:
#   VITE_API_BASE_URL=https://gw.acme.com:8443
#   VITE_API_BASE_URL=gw.acme.com          (https:// is auto-prefixed)
#   VITE_API_BASE_URL=localhost:8080       (http:// is auto-prefixed for loopback)
# Leave empty/unset to fall back to the DarkZ school management backend default.
# The value can always be overridden at runtime from the top-bar endpoint pill.
VITE_API_BASE_URL=https://sms2-api.darkzhub.asia
